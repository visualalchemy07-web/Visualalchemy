<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VisualAlchemy - Admin</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #080808;
      color: white;
      margin: 0;
      padding: 20px;
    }

    .box {
      max-width: 500px;
      margin: 30px auto;
      background: #151515;
      padding: 25px;
      border-radius: 15px;
    }

    h1 {
      text-align: center;
    }

    input, textarea, select, button {
      width: 100%;
      box-sizing: border-box;
      margin-top: 12px;
      padding: 13px;
      border-radius: 8px;
      border: 1px solid #444;
      background: #222;
      color: white;
      font-size: 16px;
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    button {
      background: #20c55a;
      border: none;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.9;
    }

    #logout {
      background: #333;
      margin-top: 10px;
    }

    #message {
      margin-top: 15px;
      text-align: center;
      font-weight: bold;
    }

    #adminPanel {
      display: none;
    }
  </style>
</head>

<body>

<div class="box">

  <h1>VisualAlchemy Admin</h1>

  <!-- LOGIN -->
  <div id="loginPanel">

    <h3>Admin Login</h3>

    <input
      type="email"
      id="email"
      placeholder="Email"
    >

    <input
      type="password"
      id="password"
      placeholder="Password"
    >

    <button onclick="login()">Login</button>

  </div>


  <!-- ADMIN PANEL -->
  <div id="adminPanel">

    <h3>Create New Post</h3>

    <input
      type="text"
      id="title"
      placeholder="Post title"
    >

    <textarea
      id="description"
      placeholder="Post description"
    ></textarea>

    <select id="category">
      <option value="">Select category</option>
      <option value="Agriculture">Agriculture</option>
      <option value="Technology">Technology</option>
      <option value="Education">Education</option>
      <option value="Science">Science</option>
      <option value="Creative">Creative</option>
      <option value="Other">Other</option>
    </select>

    <input
      type="file"
      id="image"
      accept="image/*"
    >

    <button onclick="publishPost()">
      Publish Post
    </button>

    <button id="logout" onclick="logout()">
      Logout
    </button>

  </div>

  <div id="message"></div>

</div>


<script>

